#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y nginx git python3.11 python3.11-pip

cat > /etc/nginx/conf.d/pitchcraft.conf <<'EOF'
server {
    listen 80;
    server_name _;

    location = /health {
        default_type application/json;
        return 200 '{"status":"ok","service":"pitchcraft-api-host"}';
    }

    # The FastAPI application will listen only on 127.0.0.1:8000.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
EOF

systemctl enable --now nginx

mkdir -p /opt/pitchcraft
cat > /opt/pitchcraft/README.txt <<'EOF'
Deploy the Pitchcraft API here. Run it as a systemd service bound to 127.0.0.1:8000.
The instance profile grants it access to the private artifacts S3 bucket.
EOF

echo '${artifact_bucket}' > /opt/pitchcraft/artifact-bucket-name
